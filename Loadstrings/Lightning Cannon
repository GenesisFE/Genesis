--===================================--
--          Script Options           --
--===================================--

lightmode=false --overwrite black mode colors with white
effects=true --toggle effects (if you experience performance issues try setting to false)
timemultiplier=1 --change animation speed (min=0.1,default=1,max=10)
walkspeedmultiplier=1 --change walkspeed (default=1,min/mix=-∞-->+∞)

--====================================--
--          FDless Options           --
--====================================--

fling = true --toggle fling
placeholders = true --adds transparent parts showing your hats when you don't have real ones
highlightflingtargets = true --highlight fling
allowshiftlock = true --adds shiftlock to patchma rig
ctrltp = true --adds control click tp
clickfling = false --adds click flinging regardless of attacks
flingtargetting = 3 --fling reproot method
-- 3 - sethiddenproperty
-- 2 - setscriptable
-- 1 - no unc (can be tampered with & detected)
-- 0 - off (prediction fling)
flingdirection = 0 --direction you are flinging people in
-- 0 - upwards
-- 1 - downwards
-- 2 - horizontal
flingchangestate = 3 --fling enhancements
-- 0 - none
-- 1 - changestate physics (fling with whole body)
-- 2 - disable sitting
-- 3 - all (changestate physics and disable sitting)
respawntp = 3 --respawn tp mode
-- 0 - stay at spawn
-- 1 - randomtp close
-- 2 - behind fake character
-- 3 - hide body
disguiscripts = true --disable scripts inside of playergui
discharscripts = true --disable character scripts
breakjointsmethod = 4 --breakjoints mode
-- 1 - health+breakjoints (the most support)
-- 2 - health or breakjoints
-- 3 - breakjoints
-- 4 - serverbreakjoints (replicatesignal)
hidedeatheffect = true --hides the red damage border when you die (respawn)
simrad = true --sets simulation radius

